{
  "manifest_version": 3,
  "name": "Arsène",
  "version": "0.1.0",
  "description": "Les vrais noms restent sur votre Mac : l'IA reçoit des doublures, vous lisez les vrais.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "peeps.js",
        "content.js"
      ],
      "run_at": "document_start",
      "exclude_matches": [
        "https://claude.ai/code*"
      ]
    }
  ],
  "icons": {
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "use_dynamic_url": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Arsène",
    "default_icon": {
      "128": "icon128.png"
    }
  }
}
